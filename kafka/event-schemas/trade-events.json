{
  "topic": "trade-events",
  "description": "Published by Service 2 after an order is executed/rejected. Consumed by Service 1 to refresh read state. Keyed by orderId.",
  "partitions": 3,
  "replicationFactor": 1,
  "schema": {
    "eventId": "uuid",
    "orderId": "uuid",
    "userId": "uuid",
    "instrumentId": "uuid",
    "symbol": "ABC",
    "side": "BUY|SELL",
    "quantity": "integer",
    "requestedPrice": "number|null",
    "executedPrice": "number",
    "status": "PENDING|EXECUTED|REJECTED|CANCELLED",
    "rejectReason": "string|null",
    "timestamp": "ISO-8601"
  }
}