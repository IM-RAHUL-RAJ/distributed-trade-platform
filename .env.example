# Trade Platform - environment overrides for docker compose.
# Copy to .env and adjust as needed. All values are optional (see defaults).

# ----- Database -----
DB_NAME=trade_platform
DB_USER=trade_app
DB_PASSWORD=trade_app_password
POSTGRES_PORT=5432

# ----- Kafka -----
KAFKA_PORT=9092
KAFKA_CLUSTER_ID=5L6g3nShT-eMCtK--X86sw
MARKET_DATA_POLL_INTERVAL_MS=5000

# ----- Security (SHARED between BFF and Service 1) -----
JWT_SECRET=dev-only-secret-change-me-0123456789abcdef
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_SECONDS=604800

# ----- Host ports -----
SERVICE1_PORT=8081
SERVICE2_PORT=8082
BFF_PORT=3000
FRONTEND_PORT=4200
MOCK_API_PORT=8080